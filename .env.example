# =============================================================================
# SkillScan - Skills 威胁分析引擎配置文件
# =============================================================================
# 此文件提供环境变量配置的参考值
# 配置优先级: 环境变量 > YAML配置文件 > 默认值
# YAML配置文件位于 config/ 目录下
# =============================================================================

# =============================================================================
# 应用配置
# =============================================================================
DEBUG=false
ENVIRONMENT=development
DATA_DIR=data
LOGS_DIR=logs
TEMP_DIR=tmp

# =============================================================================
# MongoDB配置
# =============================================================================
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=skillscan
MONGODB_USERNAME=
MONGODB_PASSWORD=
MONGODB_AUTH_SOURCE=admin
MONGODB_MAX_POOL_SIZE=100
MONGODB_MIN_POOL_SIZE=10

# =============================================================================
# Redis配置
# =============================================================================
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=50

# =============================================================================
# Celery配置 (异步任务队列)
# =============================================================================
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_SERIALIZER=json
CELERY_RESULT_SERIALIZER=json
CELERY_ACCEPT_CONTENT=json
CELERY_TIMEZONE=UTC
CELERY_ENABLE_UTC=true

# =============================================================================
# LLM (大模型) 配置
# =============================================================================
# OpenAI配置
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic配置
ANTHROPIC_API_KEY=your-anthropic-api-key
ANTHROPIC_MODEL=claude-3-sonnet-20240229

# LLM通用配置
LLM_MAX_TOKENS=4000
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# =============================================================================
# 扫描配置
# =============================================================================
MAX_CONCURRENT_SCANS=100
STATIC_ANALYSIS_TIMEOUT=30
LLM_ANALYSIS_TIMEOUT=25
RISK_THRESHOLD=0.5
CONFIDENCE_THRESHOLD=0.7
OVERRIDE_THRESHOLD=0.8
LLM_CONFIRM_THRESHOLD=0.6

# =============================================================================
# 爬取配置
# =============================================================================
CRAWL_CONCURRENCY=10
CRAWL_DELAY_MS=1000
CRAWL_USER_AGENT=SkillScan/1.0
CRAWL_TIMEOUT=30
CRAWL_MAX_RETRIES=3
LOCAL_SCAN_THREADS=4
LOCAL_WATCH_ENABLED=false
LOCAL_WATCH_RECURSIVE=true

# 平台API配置
CLAWHUB_API_URL=https://api.clawhub.com/v1
SMITHERY_API_URL=https://api.smithery.ai/v1
SKILLSSH_API_URL=https://api.skills.sh/v1

# =============================================================================
# API配置
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4
API_KEY=your-api-key-for-authentication
API_CORS_ORIGINS=*
API_RATE_LIMIT=100
API_RATE_LIMIT_WINDOW=60

# =============================================================================
# 性能配置
# =============================================================================
MAX_CONCURRENT_SCANS=100
BATCH_SIZE=100
CACHE_TTL=3600
MEMORY_LIMIT_MB=4096
CPU_CORES=4

# =============================================================================
# 日志配置
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=logs/skillscan.log
LOG_FORMAT=json
LOG_MAX_SIZE_MB=100
LOG_BACKUP_COUNT=10
